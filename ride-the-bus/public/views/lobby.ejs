<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link href="/dist/output.css" rel="stylesheet" />
</head>
<body class="min-h-screen bg-gray-600">
<nav class="flex items-center justify-between p-4">
    <div class="flex gap-3">
      <a href="/"
        class="px-6 py-2 bg-white text-gray-800 rounded-full font-medium hover:bg-gray-100 transition shadow-md">
        Home
      </a>
      <a href="/lobby"
        class="px-6 py-2 bg-purple-600 text-white rounded-full font-medium hover:bg-purple-700 transition shadow-md">
        Lobby-list
      </a>
    </div>

    <div class="flex gap-3 items-center">
      <button
        class="px-6 py-2 bg-purple-600 text-white rounded-full font-medium hover:bg-purple-700 transition shadow-md">
        <%= user.username %>
      </button>
      <button
        class="w-10 h-10 bg-purple-600 text-white rounded-full flex items-center justify-center hover:bg-purple-700 transition shadow-md">
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
          <path
            d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
        </svg>
      </button>
    </div>
  </nav>

  <div id="createRoomBtn" class="px-24 py-4 bg-purple-600 text-white text-lg font-semibold rounded-lg hover:bg-purple-700 transition shadow-lg text-center">Create lobby</div>

  <div class="p-6">
    <h2 class="text-white text-2xl mb-4">Available Rooms</h2>
    <div id="roomList" class="space-y-2 text-white"></div>
</div>
</body>
<script src="/socket.io/socket.io.js"></script>
<script src="/javascript/game.js"></script>
</html>
